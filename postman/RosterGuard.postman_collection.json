{
  "info": {
    "name": "RosterGuard API Collection",
    "description": "Comprehensive API collection for RosterGuard: HR event stream ingestion, nightly CSV reconciliation, transport edits, transactional outbox monitoring, and safety gates.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01. Authentication & Token Minting",
      "item": [
        {
          "name": "Mint HR Integration Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.environment.set(\"hrToken\", jsonData.token);",
                  "    pm.collectionVariables.set(\"hrToken\", jsonData.token);",
                  "    pm.test(\"Token acquired and saved to hrToken\", function () { pm.expect(jsonData.token).to.be.a('string'); });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"hr-bot\",\n  \"tenant\": \"{{tenant}}\",\n  \"roles\": [\"HR_INTEGRATION\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/dev/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dev",
                "token"
              ]
            }
          }
        },
        {
          "name": "Mint Transport Admin Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.environment.set(\"taToken\", jsonData.token);",
                  "    pm.collectionVariables.set(\"taToken\", jsonData.token);",
                  "    pm.test(\"Token acquired and saved to taToken\", function () { pm.expect(jsonData.token).to.be.a('string'); });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"transport-lead\",\n  \"tenant\": \"{{tenant}}\",\n  \"roles\": [\"TRANSPORT_ADMIN\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/dev/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dev",
                "token"
              ]
            }
          }
        },
        {
          "name": "Mint Operator Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.environment.set(\"opToken\", jsonData.token);",
                  "    pm.collectionVariables.set(\"opToken\", jsonData.token);",
                  "    pm.test(\"Token acquired and saved to opToken\", function () { pm.expect(jsonData.token).to.be.a('string'); });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"ops-admin\",\n  \"tenant\": \"{{tenant}}\",\n  \"roles\": [\"OPERATOR\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/dev/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
